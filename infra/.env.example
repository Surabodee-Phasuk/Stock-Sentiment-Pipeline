# คัดลอกเป็น infra/.env แล้วแก้ตามเครื่องตัวเอง (.env ถูก gitignore) — ไม่มีไฟล์นี้ก็ใช้ค่าด้านล่างเป็นค่าเริ่มต้น
# ห้ามใส่ access key ที่นี่: Spark อ่าน credential จาก ~/.aws

# profile ใน ~/.aws/credentials ที่ Spark ใช้เข้าถึง S3 / Glue
AWS_PROFILE=default
AWS_REGION=ap-southeast-2
# โฟลเดอร์ credential บนเครื่อง ถ้าไม่ได้อยู่ที่ ~/.aws
# AWS_DIR=/Users/<you>/.aws

KAFKA_TOPIC=stock-news
